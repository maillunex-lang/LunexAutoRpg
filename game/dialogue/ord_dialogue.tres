[gd_resource type="Resource" script_class="LunexNpcDialogueDefinition" load_steps=2 format=3]
[ext_resource type="Script" path="res://game/dialogue/npc_dialogue_definition.gd" id="1"]
[resource]
script = ExtResource("1")
npc_id = "ord"
dialogue_text = "~ start\nОрд: В Шепчущем лесу больше не слышно птиц. Зато из-под корней идёт холод.\n- Что ты нашёл?\n\tОрд: След охотника в тумане и старую печать у руин.\n- Куда идти?\n\tОрд: Через проход к часовне. Там Хранитель знает больше.\n"
